<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard | Hariharaan</title>
    <style>
      :root { --blue: #399bff; --ink: #181818; --navy: #11121e; --line: #d9e5ef; --muted: #66717d; }
      * { box-sizing: border-box; }
      body { margin: 0; color: var(--ink); background: #f4f8fb; font-family: Poppins, Arial, sans-serif; }
      header { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 5%; color: #fff; background: var(--navy); }
      header h1 { margin: 0; font-size: 1.3rem; }
      header div { display: flex; align-items: center; gap: 14px; }
      header a, header button { color: #fff; background: transparent; border: 0; font: inherit; cursor: pointer; text-decoration: none; }
      main { width: min(1440px, 90%); margin: 34px auto 70px; }
      .intro { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 25px; }
      .intro h2 { margin: 0; font-size: 2rem; }
      .intro p { margin: 7px 0 0; color: var(--muted); }
      .error { padding: 12px 16px; margin-bottom: 20px; color: #7e1f1f; background: #ffe5e5; border: 1px solid #f2b5b5; border-radius: 8px; }
      .section { margin-top: 28px; padding: 22px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 8px 22px rgba(17, 33, 49, .05); }
      .section h3 { margin: 0 0 18px; font-size: 1.3rem; }
      .create-form, .edit-form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
      .field { display: grid; gap: 6px; }
      .field.full { grid-column: 1 / -1; }
      label { color: var(--muted); font-size: .78rem; font-weight: 600; }
      input, textarea { width: 100%; padding: 10px 11px; border: 1px solid var(--line); border-radius: 7px; font: inherit; }
      textarea { min-height: 80px; resize: vertical; }
      button, .button { display: inline-block; padding: 9px 14px; border: 0; border-radius: 7px; color: #fff; background: #1768a9; font: inherit; font-size: .85rem; font-weight: 600; cursor: pointer; text-decoration: none; }
      .create-form button { grid-column: 1 / -1; justify-self: start; background: var(--blue); color: var(--ink); }
      .items { display: grid; gap: 14px; margin-top: 22px; }
      .item { padding-top: 18px; border-top: 1px solid var(--line); }
      .item:first-child { padding-top: 0; border-top: 0; }
      .item-actions { display: flex; gap: 9px; margin-top: 12px; }
      .delete { background: #a52d35; }
      .empty { color: var(--muted); font-size: .9rem; }
      @media (max-width: 700px) {
        header { align-items: flex-start; flex-direction: column; }
        main { width: calc(100% - 28px); margin-top: 20px; }
        .intro { display: block; }
        .create-form, .edit-form { grid-template-columns: 1fr; }
        .field.full, .create-form button { grid-column: auto; }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Portfolio Admin</h1>
      <div><a href="/" target="_blank" rel="noreferrer">View site</a><form method="post" action="/admin/logout"><button type="submit">Sign out</button></form></div>
    </header>
    <main>
      <div class="intro"><div><h2>Manage content</h2><p>Changes are saved directly to MongoDB and appear on the public site.</p></div></div>
      <% if (error) { %><div class="error"><%= error %></div><% } %>

      <section class="section">
        <h3>Skills</h3>
        <form class="create-form" method="post" action="/admin/skills">
          <div class="field"><label for="skill-name">Name</label><input id="skill-name" name="name" required /></div>
          <div class="field"><label for="skill-image">Image filename</label><input id="skill-image" name="image" placeholder="React.svg" required /></div>
          <div class="field"><label for="skill-order">Order</label><input id="skill-order" name="order" type="number" value="0" /></div>
          <button type="submit">Add skill</button>
        </form>
        <div class="items">
          <% skills.forEach((skill) => { %>
            <div class="item"><form class="edit-form" method="post" action="/admin/skills/<%= skill._id %>/update">
              <div class="field"><label>Name</label><input name="name" value="<%= skill.name %>" required /></div>
              <div class="field"><label>Image filename</label><input name="image" value="<%= skill.image %>" required /></div>
              <div class="field"><label>Order</label><input name="order" type="number" value="<%= skill.order %>" /></div>
              <div class="item-actions"><button type="submit">Save changes</button></div>
            </form><form class="item-actions" method="post" action="/admin/skills/<%= skill._id %>/delete"><button class="delete" type="submit">Delete</button></form></div>
          <% }); %>
          <% if (!skills.length) { %><p class="empty">No skills added yet.</p><% } %>
        </div>
      </section>

      <section class="section">
        <h3>Projects</h3>
        <form class="create-form" method="post" action="/admin/projects">
          <div class="field"><label for="project-name">Display name</label><input id="project-name" name="project" required /></div>
          <div class="field"><label for="project-id">Project ID / URL slug</label><input id="project-id" name="project_id" placeholder="my-project" required /></div>
          <div class="field"><label for="project-image">Image filename without extension</label><input id="project-image" name="image" placeholder="my-project" /></div>
          <div class="field"><label for="project-video">Video filename without extension</label><input id="project-video" name="video" placeholder="my-project" /></div>
          <div class="field"><label for="project-order">Order</label><input id="project-order" name="order" type="number" value="0" /></div>
          <div class="field full"><label for="project-content">Short content</label><textarea id="project-content" name="content" required></textarea></div>
          <div class="field full"><label for="project-about">About</label><textarea id="project-about" name="about" required></textarea></div>
          <div class="field"><label for="project-techstack">Tech stack</label><textarea id="project-techstack" name="techstack" required></textarea></div>
          <div class="field"><label for="project-features">Key features, one per line</label><textarea id="project-features" name="key_features" required></textarea></div>
          <button type="submit">Add project</button>
        </form>
        <div class="items">
          <% projects.forEach((project) => { %>
            <div class="item"><form class="edit-form" method="post" action="/admin/projects/<%= project._id %>/update">
              <div class="field"><label>Display name</label><input name="project" value="<%= project.project %>" required /></div>
              <div class="field"><label>Project ID / URL slug</label><input name="project_id" value="<%= project.project_id %>" required /></div>
              <div class="field"><label>Image filename</label><input name="image" value="<%= project.image || '' %>" /></div>
              <div class="field"><label>Video filename</label><input name="video" value="<%= project.video || '' %>" /></div>
              <div class="field"><label>Order</label><input name="order" type="number" value="<%= project.order %>" /></div>
              <div class="field full"><label>Short content</label><textarea name="content" required><%= project.content %></textarea></div>
              <div class="field full"><label>About</label><textarea name="about" required><%= project.about %></textarea></div>
              <div class="field"><label>Tech stack</label><textarea name="techstack" required><%= project.techstack %></textarea></div>
              <div class="field"><label>Key features</label><textarea name="key_features" required><%= project.key_features %></textarea></div>
              <div class="item-actions"><button type="submit">Save changes</button></div>
            </form><form class="item-actions" method="post" action="/admin/projects/<%= project._id %>/delete"><button class="delete" type="submit">Delete</button></form></div>
          <% }); %>
          <% if (!projects.length) { %><p class="empty">No projects added yet.</p><% } %>
        </div>
      </section>

      <section class="section">
        <h3>Achievements</h3>
        <form class="create-form" method="post" action="/admin/achievements">
          <div class="field"><label for="achievement-title">Title</label><input id="achievement-title" name="title" required /></div>
          <div class="field"><label for="achievement-badge">Badge</label><input id="achievement-badge" name="badge" placeholder="Finalist" required /></div>
          <div class="field"><label for="achievement-organization">Organization</label><input id="achievement-organization" name="organization" required /></div>
          <div class="field"><label for="achievement-date">Date</label><input id="achievement-date" name="date" required /></div>
          <div class="field"><label for="achievement-image">Image filename</label><input id="achievement-image" name="image" required /></div>
          <div class="field"><label for="achievement-order">Order</label><input id="achievement-order" name="order" type="number" value="0" /></div>
          <div class="field full"><label for="achievement-description">Description</label><textarea id="achievement-description" name="description" required></textarea></div>
          <button type="submit">Add achievement</button>
        </form>
        <div class="items">
          <% achievements.forEach((achievement) => { %>
            <div class="item"><form class="edit-form" method="post" action="/admin/achievements/<%= achievement._id %>/update">
              <div class="field"><label>Title</label><input name="title" value="<%= achievement.title %>" required /></div>
              <div class="field"><label>Badge</label><input name="badge" value="<%= achievement.badge %>" required /></div>
              <div class="field"><label>Organization</label><input name="organization" value="<%= achievement.organization %>" required /></div>
              <div class="field"><label>Date</label><input name="date" value="<%= achievement.date %>" required /></div>
              <div class="field"><label>Image filename</label><input name="image" value="<%= achievement.image %>" required /></div>
              <div class="field"><label>Order</label><input name="order" type="number" value="<%= achievement.order %>" /></div>
              <div class="field full"><label>Description</label><textarea name="description" required><%= achievement.description %></textarea></div>
              <div class="item-actions"><button type="submit">Save changes</button></div>
            </form><form class="item-actions" method="post" action="/admin/achievements/<%= achievement._id %>/delete"><button class="delete" type="submit">Delete</button></form></div>
          <% }); %>
          <% if (!achievements.length) { %><p class="empty">No achievements added yet.</p><% } %>
        </div>
      </section>
    </main>
  </body>
</html>
