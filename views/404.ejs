<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 | Page Not Found</title>
    <style>
      :root {
        --blue: #399bff;
        --ink: #181818;
        --muted: #757575;
      }
      * {
        box-sizing: border-box;
      }
      body {
        min-height: 100vh;
        margin: 0;
        display: grid;
        place-items: center;
        padding: 24px;
        color: #fff;
        background:
          radial-gradient(circle at 15% 20%, rgba(57, 155, 255, 0.22), transparent 32%),
          linear-gradient(135deg, #11121e, #033363);
        font-family: Poppins, Arial, sans-serif;
      }
      main {
        width: min(620px, 100%);
        padding: clamp(32px, 7vw, 70px);
        text-align: center;
        background: rgba(255, 255, 255, 0.09);
        border: 1px solid rgba(255, 255, 255, 0.24);
        border-radius: 24px;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
      }
      .code {
        margin: 0;
        color: var(--blue);
        font-size: clamp(4rem, 16vw, 8rem);
        line-height: 0.9;
        font-weight: 700;
      }
      h1 {
        margin: 24px 0 12px;
        font-size: clamp(1.5rem, 4vw, 2.25rem);
      }
      p {
        margin: 0 auto 30px;
        max-width: 420px;
        color: #dceeff;
        line-height: 1.6;
      }
      a {
        display: inline-block;
        padding: 12px 22px;
        color: var(--ink);
        background: var(--blue);
        border-radius: 999px;
        font-weight: 600;
        text-decoration: none;
        transition: transform 180ms ease, background 180ms ease;
      }
      a:hover,
      a:focus-visible {
        background: #75bcff;
        transform: translateY(-2px);
      }
      a:focus-visible {
        outline: 3px solid #fff;
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <main>
      <p class="code">404</p>
      <h1>Page not found</h1>
      <p>The page you are looking for does not exist or may have moved.</p>
      <a href="/">Return home</a>
    </main>
  </body>
</html>
