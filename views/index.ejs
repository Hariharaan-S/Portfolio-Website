<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hariharaan S — Full Stack Developer</title>
    <link rel="shortcut icon" href="images/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script
      src="https://kit.fontawesome.com/c1b3701aff.js"
      crossorigin="anonymous"
    ></script>
    <link rel="stylesheet" href="css/styles.css" />
  </head>
  <body>
    <header class="site-header">
      <nav class="top-nav" aria-label="Primary navigation">
        <button
          class="menu-toggle"
          type="button"
          aria-label="Toggle navigation"
          aria-expanded="false"
        >
          <span></span><span></span><span></span>
        </button>
        <div class="nav-left">
          <a class="active" href="#home">Home</a><a href="#services">Service</a
          ><a href="#about">About</a>
        </div>
        <a class="brand" href="/" aria-label="Hariharaan home">
          <span><img src="images/HS.png" alt="HS" /></span
          ><strong>HARI<span style="color: var(--blue)">.</span></strong>
        </a>
        <div class="nav-right">
          <a href="Resume Hariharaan S.pdf" download>Resume</a
          ><a href="#projects">Project</a><a href="#contact">Contact</a>
        </div>
      </nav>
      <div class="mobile-nav" aria-hidden="true">
        <a href="#home">Home</a><a href="#about">About</a> ><a href="#services"
          >Service</a
        ><a href="Resume Hariharaan S.pdf" download>Resume</a
        ><a href="#projects">Project</a><a href="#contact">Contact</a>
      </div>
    </header>
    <main>
      <section class="hero" id="home">
        <div class="hero-intro">
          <small>Hello!</small>
          <h1>I’m <span>Hariharaan,</span><br />Full Stack Developer</h1>
        </div>
        <p class="recommendation">
          Hari’s exceptional web development<br />ensure our webapp’s success<br /><strong
            >Highly Recommended</strong
          >
        </p>
        <div class="hero-portrait">
          <img src="images/profile.png" alt="Portrait of Hariharaan" />
        </div>
        <div class="rating">
          <div class="stars">★★★★★</div>
          <strong>1.5+ Years</strong><small>Experience</small>
        </div>
      </section>
      <section class="services" id="services">
        <div class="services-heading">
          <h2>My <span>Services</span></h2>
          <p>
            I build scalable digital solutions by combining modern technologies,
            machine learning, and strong problem-solving skills to create
            efficient, reliable, and user-focused experiences.
          </p>
        </div>
        <div class="services-grid">
          <a
            class="service-card"
            href="http://localhost:5000/services/Web%20Development"
          >
            <img
              class="service-icon"
              src="images/web.png"
              alt=""
              aria-hidden="true"
            />
            <h3>Web Development</h3>
            <p>
              I develop responsive and scalable web applications using modern
              frontend and backend technologies, with a focus on clean
              architecture, seamless user experiences, and reliable performance.
            </p>
          </a>
          <a
            class="service-card"
            href="http://localhost:5000/services/ML%20Development"
          >
            <img
              class="service-icon"
              src="images/ml.png"
              alt=""
              aria-hidden="true"
            />
            <h3>ML Development</h3>
            <p>
              I build machine learning solutions that transform data into
              meaningful insights, from developing and fine-tuning models to
              integrating them into practical applications.
            </p>
          </a>
          <a
            class="service-card"
            href="http://localhost:5000/services/Competitive%20Coding"
          >
            <img
              class="service-icon"
              src="images/code.png"
              alt=""
              aria-hidden="true"
            />
            <h3>Competitive Coding</h3>
            <p>
              I solve complex programming problems using efficient algorithms
              and data structures, focusing on logical thinking, optimization,
              and writing clean, effective code.
            </p>
          </a>
        </div>
      </section>
      <section class="experience" id="about">
        <h2>My <span>Work Experience</span></h2>
        <div class="experience-list">
          <article>
            <div>
              <h3>Accenture, Bengaluru</h3>
              <time>Oct 2025 - Present</time>
            </div>
            <i class="dot blue"></i>
            <div>
              <h3>Packaged App Development<br />Associate</h3>
              <p>
                Trained in foundational concepts, assigned to live project tasks
                involving feature development, bug fixing, and code reviews
                within an agile environment.
              </p>
            </div>
          </article>
          <article>
            <div>
              <h3>ProjectSense, Remote</h3>
              <time>Dec 2023 - Jan 2024</time>
            </div>
            <i class="dot dark"></i>
            <div>
              <h3>Intern - Full Stack Developer</h3>
              <p>
                Trained in foundational concepts, assigned to live project tasks
                involving feature development, bug fixing, and code reviews
                within an agile environment.
              </p>
            </div>
          </article>
        </div>
      </section>
      <section class="unique" aria-labelledby="unique-heading">
        <div class="unique-heading">
          <h2 id="unique-heading">How I am <span>Unique?</span></h2>
          <p>
            Recognized for technical excellence through national-level
            hackathons, competitive challenges, and innovative problem-solving,
            showcasing my ability to collaborate, build impactful solutions, and
            perform under challenging environments.
          </p>
        </div>

        <div class="unique-carousel" aria-live="polite">
          <div class="unique-carousel-track">
            <% achievements.forEach((achievement, index) => { %>
              <article class="achievement-card <%= index === 0 ? 'is-active' : '' %>">
                <div class="achievement-image-wrap">
                  <img src="images/<%= achievement.image %>" alt="<%= achievement.title %>" />
                </div>
                <div class="achievement-content">
                  <div class="achievement-badge"><%= achievement.badge %></div>
                  <h3><%= achievement.title %></h3>
                  <p class="achievement-meta">
                    <%= achievement.organization %> · <%= achievement.date %>
                  </p>
                  <p><%= achievement.description %></p>
                </div>
              </article>
            <% }); %>
          </div>
        </div>

        <div class="slider-dots" aria-label="Carousel pages">
          <% achievements.forEach((achievement, index) => { %>
            <button class="<%= index === 0 ? 'is-active' : '' %>" aria-label="Slide <%= index + 1 %>"></button>
          <% }); %>
        </div>
      </section>
      <section class="skills" aria-labelledby="skills-heading">
        <h2 id="skills-heading">What <span>Skills</span> I posses ?</h2>
        <div class="skills-carousel">
          <div class="skills-wrap">
            <div class="skill-grid">
              <% for (let index = 0; index < skills.length; index += 4) { %>
                <div class="skill-row">
                  <% skills.slice(index, index + 4).forEach((skill) => { %>
                    <div class="skill-card">
                      <img src="images/<%= skill.image %>" alt="<%= skill.name %>" />
                      <span><%= skill.name %></span>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>

          <div class="skills-bar-dots" aria-label="Skills pages">
            <% for (let index = 0; index < Math.max(1, Math.ceil(skills.length / 4)); index += 1) { %>
              <button class="<%= index === 0 ? 'is-active' : '' %>" aria-label="Skills page <%= index + 1 %>"></button>
            <% } %>
          </div>
        </div>
      </section>
      <section class="projects" id="projects">
        <h2>
          Let’s have a look at my <br />
          <span>Project Works</span>
        </h2>

        <div class="projects-carousel" aria-label="Project carousel">
          <div class="projects-track">
            <% for (let index = 0; index < projects.length; index += 2) { %>
              <div class="project-slide">
                <% projects.slice(index, index + 2).forEach((project) => { %>
                  <a class="project-card" href="/projects/<%= encodeURIComponent(project.project_id) %>">
                    <img src="images/<%= project.image || project.project_id %>.png" alt="<%= project.project %>" />
                    <span class="project-arrow">→</span>
                    <strong><%= project.project %></strong>
                  </a>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>

        <div class="project-dots" aria-label="Project pages">
          <span class="is-active"></span><span></span>
        </div>
      </section>
    </main>
    <footer class="footer" id="contact">
      <div class="footer-top">
        <h2>Lets Connect there...</h2>
        <div class="footer-social">
          <a
            href="https://www.linkedin.com/in/hariharaan-s-ba9242233/"
            aria-label="LinkedIn"
            ><i class="fa-brands fa-linkedin-in"></i></a
          ><a href="https://github.com/Hariharaan-S" aria-label="GitHub"
            ><i class="fa-brands fa-github"></i></a
          ><a href="https://wa.me/918072823999" aria-label="WhatsApp"
            ><i class="fa-brands fa-whatsapp"></i
          ></a>
        </div>
      </div>
      <div class="footer-main">
        <div class="footer-profile">
          <a class="brand" href="#home" aria-label="Hariharaan home">
            <span><img src="images/HS.png" alt="HS" /></span>
            <strong>HARI.</strong>
          </a>
          <p>
            Building ideas into impactful digital experiences through code,
            creativity, and continuous learning.
          </p>
        </div>
        <div>
          <h4>Navigation</h4>
          <a href="#home">Home</a><a href="#about">About</a
          ><a href="#skills-heading">Skills</a><a href="#projects">Projects</a>
        </div>
        <div class="footer-contact">
          <h4>Contact Me</h4>
          <a href="tel:+918072823999"
            ><i class="fa-solid fa-phone" aria-hidden="true"></i
            ><span>+91 80728 23999</span></a
          ><a href="mailto:shariharaan123@gmail.com"
            ><i class="fa-solid fa-envelope" aria-hidden="true"></i
            ><span>shariharaan123@gmail.com</span></a
          >
        </div>
      </div>
      <div class="footer-bottom">
        <small
          >Copyright © <span id="year"></span> Hariharaan. All Rights
          Reserved.</small
        ><small>User Terms &amp; Conditions | Privacy Policy</small>
      </div>
    </footer>
    <script src="js/index.js"></script>
  </body>
</html>
